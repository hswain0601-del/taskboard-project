pipeline {
    agent any
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'v6', description: 'Tag for the Docker image')
    }
    environment {
        IMAGE_NAME = "himansh0074/taskboard-app-project"
    }
    stages {
        stage('Pull Image') {
            steps {
                sh "docker pull ${IMAGE_NAME}:${params.IMAGE_TAG}"
            }
        }
        stage ('Stop existing container') {
            steps {
                sh "docker stop taskboard-app || true"
                    sh "docker rm taskboard-app || true"
                }
        }
                stage('Run new container') {
                    steps {
                        sh "docker run -d --name taskboard-app -p 5000:5000 ${IMAGE_NAME}:${params.IMAGE_TAG}"
                    }
                }
                    stage('Verify Deployment') {
                        steps {
                            sh "docker ps"
                        }
                    }
                
            
        }

}
